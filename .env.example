# Contact / quote form delivery. Configured for Amazon SES v2 to match the
# planned AWS production deployment.

# Region where your SES sending identity lives, e.g. us-east-2.
# NOTE: on Amplify/Lambda the "AWS_" prefix is reserved, so use SES_REGION
# there. Locally, AWS_SES_REGION also works; AWS_REGION is used as a last resort.
SES_REGION=us-east-2

# Verified SES identity used as the From address. Must be an address or
# domain you've verified in the SES console. Until your account is out
# of the SES sandbox, you can only send TO addresses you've also verified.
CONTACT_FROM=website@scaniomoving.com

# Optional: where quote requests are delivered. One address or a
# comma-separated list to fan out to several inboxes. Defaults to
# info@scaniomoving.com (the value in src/lib/contact.ts).
# CONTACT_TO=info@scaniomoving.com
# CONTACT_TO=info@scaniomoving.com, idan@scaniomoving.com

# SES credentials. On Amplify/Lambda the AWS_ prefix is reserved, so use
# these custom names (a restricted ses:SendEmail-only IAM user). When unset,
# the SDK uses its default chain (instance/task role on App Runner/EC2, or
# standard AWS_ creds locally).
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=


# ─── SEO / analytics ───────────────────────────────────────────────

# Canonical site origin used for metadata, sitemap, robots, and JSON-LD.
# Defaults to https://www.scaniomoving.com. Override for staging/preview.
# NEXT_PUBLIC_SITE_URL=https://www.scaniomoving.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When unset, no
# analytics script is loaded — so production never ships a broken/placeholder
# tag. Set this to enable GA4 tracking.
# NEXT_PUBLIC_GA_ID=
