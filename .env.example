# Contact form / quote request — required for /api/contact to actually send mail.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override the recipient of quote requests. Defaults to info@scaniomoving.com.
# CONTACT_TO=info@scaniomoving.com

# Optional: override the "From" address. Must be a domain you've verified with
# Resend (e.g. website@scaniomoving.com). Defaults to Resend's onboarding sender
# (onboarding@resend.dev) which works without domain verification but should be
# replaced before launch.
# CONTACT_FROM=website@scaniomoving.com
